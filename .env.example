# ---------------------------------------------------------------------------
# fritz-kola Scoreboard – Environment-Variablen
# Kopiere diese Datei nach `.env.local` und trage die echten Werte ein.
# ---------------------------------------------------------------------------

# Supabase Projekt-URL (Project Ref: lajdtuomawqyyfqqpxhb)
NEXT_PUBLIC_SUPABASE_URL=https://lajdtuomawqyyfqqpxhb.supabase.co

# Supabase Anon Key (Project Settings -> API -> anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Erlaubte Firmendomain fuer die Registrierung (ohne @).
# Nur E-Mail-Adressen auf dieser Domain duerfen sich registrieren.
NEXT_PUBLIC_ERLAUBTE_DOMAIN=fritz-kola.com

# ---------------------------------------------------------------------------
# Nur fuer lokale Migrationen / Server-Skripte (NICHT im Client verwenden):
# Direkte Postgres-Verbindung (Passwort aus Supabase Dashboard einsetzen):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.lajdtuomawqyyfqqpxhb.supabase.co:5432/postgres
#
# Service-Role Key (nur serverseitig, z. B. fuer Admin-Skripte):
# SUPABASE_SERVICE_ROLE_KEY=
# ---------------------------------------------------------------------------
